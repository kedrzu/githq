                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A faster way to work the one you already have.",
                  "lineHeight": 1.18,
                  "fontFamily": "Geist",
                  "fontSize": 44,
                  "fontWeight": "500",
                  "letterSpacing": -1.3
                }
