              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "T2AGM",
              "name": "Note",
              "fill": "$fg-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "—  05 Instant — a card moves from Todo to In progress, then the “saved to GitHub” toast slides up. No loader anywhere: that’s the point.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "KsvU7",
              "name": "Note",
              "fill": "$fg-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "—  06 Keyboard — keycaps press in sequence (⌘K → S → ↵) in sync with the palette in the screenshot; pressed key drops its bottom border.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "yRzMs",
              "name": "Note",
              "fill": "$fg-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "—  The hero has no address bar and no loop: its screenshot stays still.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "lw54t",
              "name": "Note",
              "fill": "$fg-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "—  Everything under 400 ms, ease-out, no parallax, no scroll-jacking. Calm, like the app.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        }
