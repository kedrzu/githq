                    {
                      "type": "text",
                      "id": "espM6",
                      "name": "Caption note",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Below about 1200 px of window the details don't fit beside the graph, so they sit under it, the full width of the pane at a fixed 45% of its height, and open by themselves as they do on a wide window: the selection shows its commit. J and K, or a click, move on and they follow; Esc closes them and the next move shows them again. The cursor's row stays in view in the shorter graph. B still opens the branch and tag list over the graph (CH47), which covers the graph only and leaves the details where they are.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
