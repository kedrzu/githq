                              "fontFamily": "$font",
                              "fontSize": 12.5,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "Jv41h",
                          "name": "Message field",
                          "clip": true,
                          "width": "fill_container",
                          "height": 300,
                          "fill": "$bg",
                          "cornerRadius": 6,
                          "stroke": "$control-border",
                          "strokeWidth": 1,
                          "padding": [
                            8,
