# Generated by the nzyme CLI (`bun run monorepo`, `bun run localise`), never committed.
tsconfig.json
tsconfig.cjs.json
*.loc.ts
# ...except the Nuxt app's: written by hand, it extends `.nuxt/tsconfig.json`.
!/packages/app/tsconfig.json
# ...and the GitHub package scripts', written by hand for type-aware lint of `scripts/`.
!/packages/github/scripts/tsconfig.json
/INDEX.md
/UTILS.md
/packages/*/INDEX.md

# The local build of the app (`bun --cwd packages/app build:local`).
.output-local
.nuxt-local

# The desktop build of the app (`bun --cwd packages/app build:desktop`) and the desktop app's Rust build.
.output-desktop
.nuxt-desktop
target/
# Written by tauri-build on every cargo build (schemas in its own JSON style, which the formatter would reject).
/packages/desktop/src-tauri/gen/
# Also tauri-build's: the permissions of the app's own commands, from the list in `build.rs`.
/packages/desktop/src-tauri/permissions/autogenerated/
