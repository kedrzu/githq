                      "fontSize": 13,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "eNEBK",
                      "name": "Explanation",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "githq creates a private repository named githq-settings in your account, with one file: the repositories and projects you track. Another computer can then load them. Views stay on this device. githq has no server and keeps nothing about you; the data is yours, in your repository. Leave this off and nothing leaves this device.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font",
                      "fontSize": 12.5,
                      "fontWeight": "normal"
                    }
                  ]
                }
