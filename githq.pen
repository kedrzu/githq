        {
          "type": "frame",
          "id": "AKc6Q",
          "name": "Group header",
          "width": 1400,
          "layout": "vertical",
          "gap": 8,
          "padding": [
            40,
            0,
            0,
            0
          ],
          "children": [
            {
              "type": "text",
              "id": "yChuG",
              "name": "Group title",
              "fill": "$fg",
              "content": "4 · A commit's details",
              "fontFamily": "$font",
              "fontSize": 22,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "YfRPp",
              "name": "Group note",
              "fill": "$fg-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "↵ on a row, or a click, opens the commit's details. A commit is not an item: it has no state to edit and nothing to comment on, so it opens only in the panel, on the right of the graph with the list staying on the left, never as a modal or a page. J and K keep moving through the graph with the panel open, and the panel follows the selected row. P goes to the first parent, ⇧P to the second of a merge; ⇧↵ opens the commit's pull request as any item opens. Esc closes. Below about 1200 px they open over the graph from the right.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "QhuJ0",
          "name": "Row of screens · Details",
          "gap": 80,
          "children": [
            {
              "type": "frame",
              "id": "PwA3H",
              "name": "Slot · CH18 · Beside the graph",
              "width": 1440,
              "layout": "vertical",
              "gap": 14,
              "children": [
                {
                  "type": "frame",
                  "id": "AK4QC",
                  "name": "Caption",
                  "width": 1440,
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "text",
                      "id": "eay0d",
                      "name": "Caption title",
                      "fill": "$fg",
                      "content": "CH18 · Beside the graph",
                      "fontFamily": "$font",
                      "fontSize": 15,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "bwpqi",
                      "name": "Caption note",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The selection shows its commit: the details are open from the moment the section opens, on the newest commit of the default branch, and J, K or a click move them on. Esc closes them and the next move shows them again. On the right of the graph with the list staying, 440 px by default; their left edge drags, or ←/→ on it when focused, from 320 px to what leaves the graph 240 px, kept on this device under its own name. The panel is the one in CH55: the facts card, then the message, one scroll. A failing commit: the dot and the Checks group say red, and the group names its two failing checks.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
