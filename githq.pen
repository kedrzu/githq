          "name": "Row of screens · The panel",
          "gap": 80,
          "children": [
            {
              "type": "frame",
              "id": "DeNri",
              "name": "Slot · CH55 · One scroll: the facts, then the message",
              "layout": "vertical",
              "gap": 14,
              "children": [
                {
                  "type": "frame",
                  "id": "ApYCB",
