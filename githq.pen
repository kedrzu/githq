                        },
                        {
                          "type": "text",
                          "id": "p4dQP",
                          "name": "Caption note",
                          "fill": "$fg-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "From the top-right in a repository: the form opens in that repository, shown in its Repository row and changed from there (D43). Title first, keyboard up, because the point is to get it down before you forget; under it the details as on an item (MB194), then the description (MB268). Inside a task the ⌘ button leaves, as when writing a reply (MB71).",
                          "lineHeight": 1.45,
