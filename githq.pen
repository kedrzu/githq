                        {
                          "type": "frame",
                          "id": "Svt1W",
                          "name": "Message field",
                          "clip": true,
                          "width": "fill_container",
                          "height": 240,
                          "fill": "$bg",
                          "cornerRadius": 6,
                          "stroke": "$border-2",
                          "strokeWidth": 1,
                          "padding": [
                            8,
