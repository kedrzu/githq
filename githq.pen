                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Replaced by CR120: the line cursor's comment button. The hovered line's number turns accent and underlined, with a small comment icon in the margin before it: click the number to comment, drag along the numbers or ⇧click for a range (D32). Code under the pointer stays selectable as text. Shown on context, added and deleted lines, in split and unified, and during a range drag.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font",
                      "fontSize": 12.5,
                      "fontWeight": "normal"
                    }
