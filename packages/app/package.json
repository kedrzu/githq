{
    "name": "@githq/app",
    "private": true,
    "description": "githq web app (Nuxt SPA, built to static files)",
    "license": "AGPL-3.0-only",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        "./*.js": "./*.ts",
        "./*.vue": "./*.vue"
    },
    "scripts": {
        "dev": "nuxt dev --bun",
        "build": "nx run @githq/docs:build && GITHQ_TARGET=production nuxt generate --bun && bun scripts/copyDocs.ts .output && bun scripts/checkProductionBuild.ts",
        "build:local": "nx run @githq/docs:build && GITHQ_TARGET=local nuxt generate --bun && bun scripts/copyDocs.ts .output-local && bun scripts/checkLocalBuild.ts",
        "build:desktop": "GITHQ_TARGET=desktop nuxt generate --bun && bun scripts/checkDesktopBuild.ts",
        "dev:desktop": "GITHQ_TARGET=desktop nuxt dev --bun",
        "typecheck": "nuxi typecheck",
        "prep": "nuxt prepare",
        "storybook": "storybook dev --port 6006 --no-open",
        "build-storybook": "storybook build",
        "test:stories": "vitest run --project=storybook --reporter=dot",
        "playwright:install": "playwright install chromium",
        "icons": "bun scripts/generateIcons.ts",
        "lighthouse": "bun scripts/lighthouse.ts"
    },
    "dependencies": {
        "@fontsource/geist": "5.3.0",
        "@fontsource/inter": "5.3.0",
        "@fontsource/jetbrains-mono": "5.3.0",
        "@githq/github": "workspace:*",
        "@leeoniya/ufuzzy": "1.0.19",
        "@nuxt/image": "2.2.1",
        "@nzyme/dom-utils": "workspace:*",
        "@nzyme/i18n": "workspace:*",
        "@nzyme/i18n-core": "workspace:*",
        "@nzyme/ioc": "workspace:*",
        "@nzyme/logging": "workspace:*",
        "@nzyme/types": "workspace:*",
        "@nzyme/utils": "workspace:*",
        "@nzyme/vue": "workspace:*",
        "@nzyme/vue-forms": "workspace:*",
        "@nzyme/vue-i18n": "workspace:*",
        "@nzyme/vue-ioc": "workspace:*",
        "@nzyme/vue-utils": "workspace:*",
        "fast-myers-diff": "3.2.0",
        "highlight.js": "11.12.0",
        "idb": "8.0.4",
        "lucide-vue-next": "1.0.0",
        "nuxt": "4.4.8",
        "reka-ui": "2.10.5",
        "vue": "3.5.44",
        "vue-router": "5.4.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@nzyme/crypto": "workspace:*",
        "@nzyme/ioc-testing": "workspace:*",
        "@nzyme/nuxt-tools": "workspace:*",
        "@playwright/test": "1.64.0",
        "@resvg/resvg-js": "2.6.2",
        "@storybook/addon-a11y": "10.6.1",
        "@storybook/addon-docs": "10.6.1",
        "@storybook/addon-vitest": "10.6.1",
        "@storybook/vue3": "10.6.1",
        "@storybook/vue3-vite": "10.6.1",
        "@types/opentype.js": "1.3.10",
        "@vitejs/plugin-vue": "6.0.10",
        "@vitejs/plugin-vue-jsx": "5.1.6",
        "@vitest/browser": "4.1.12",
        "@vitest/browser-playwright": "4.1.12",
        "beasties": "0.5.5",
        "chrome-launcher": "1.2.2",
        "fake-indexeddb": "6.2.6",
        "lighthouse": "13.6.0",
        "opentype.js": "1.3.4",
        "sass": "1.108.1",
        "storybook": "10.6.1",
        "typescript": "6.0.3",
        "vite": "7.3.7",
        "vitest": "4.1.12",
        "vue-tsc": "3.3.13"
    },
    "nx": {
        "targets": {
            "build": {
                "dependsOn": [
                    "^build",
                    "typecheck"
                ],
                "inputs": [
                    "production",
                    "^production",
                    "localEnvironment",
                    "appEnvironment",
                    {
                        "input": "production",
                        "projects": "@githq/docs"
                    }
                ]
            },
            "build:local": {
                "cache": true,
                "inputs": [
                    "production",
                    "^production",
                    {
                        "input": "production",
                        "projects": "@githq/docs"
                    }
                ],
                "outputs": [
                    "{projectRoot}/.output-local"
                ]
            },
            "build:desktop": {
                "cache": true,
                "inputs": [
                    "production",
                    "^production",
                    {
                        "env": "GITHQ_ENV"
                    }
                ],
                "outputs": [
                    "{projectRoot}/.output-desktop"
                ]
            }
        }
    }
}
