# Copy to `.env` in the main checkout (gitignored; setup.sh copies it into new worktrees); `wrangler dev` reads it. The githq OAuth
# App's credentials, from GitHub → Settings → Developer settings → OAuth Apps; its callback URL for development
# is http://localhost:8787/auth/callback. In production both are Worker secrets (`bunx wrangler secret put`).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
