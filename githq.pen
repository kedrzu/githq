                    {
                      "type": "text",
                      "id": "fIxzC",
                      "name": "Caption note",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A failing commit keeps its lane: its dot becomes a 1.5 px ring in the lane's colour, then 1 px of the row's own background (the lane is cut inside the ring, so $sel or the hover shows through), then a red disc 5 px across; a running one has an amber disc. Lane and state both read, and the mark is a shape of its own beside a plain dot (solid, r = 3) and a merge (hollow), so it doesn't lean on red alone. It is r = 5 overall, so the selected and hovered rings grew from 14 to 16 px to stay 1.5 px clear of it (3.5 px from a plain dot). The red ✕ after the pull request stays. Every graph in the file draws it this way.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
