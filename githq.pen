                      "children": [
                        {
                          "type": "text",
                          "id": "zkIQX",
                          "name": "Name",
                          "fill": "#E4E6EA",
                          "content": "03  Closed issue",
                          "fontFamily": "Inter",
                          "fontSize": 17,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "GhrVv",
                          "name": "Rationale",
                          "fill": "#9AA0A9",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "GitHub’s issue ring, ticked off: the whole job of a task manager is getting things to done. Reads instantly as “issues”, but the green borrows GitHub’s own merged/closed language. Friendly Manrope, “hq” stepped back.",
                          "lineHeight": 1.55,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
