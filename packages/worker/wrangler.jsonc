// The githq Worker — the whole app on one domain (D16). Cloudflare serves the SPA (the static build of
// `packages/app`) straight from its assets, without running any Worker code; the Worker runs only for
// `/api/*`, where it trades GitHub's OAuth code for a token (D1, `src/githubOAuth.ts`) — GitHub's token
// endpoint answers no CORS and needs the client secret, so a browser cannot do it alone. The Worker is
// stateless: no bindings, no storage, no task data. Build the SPA before deploying
// (`bun --cwd packages/app build`).
//
// Secrets: the OAuth App's `GITHUB_CLIENT_ID` and `GITHUB_CLIENT_SECRET`, set once with
// `bunx wrangler secret put <name>`; `wrangler dev` reads them from the repo root `.env` (`--env-file`, template `.env.example`).
{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "githq",
    "main": "src/worker.ts",
    // Wrangler bundles `main` with esbuild; minified, the bundle is smaller and the Worker starts faster.
    "minify": true,
    "compatibility_date": "2026-10-15",
    "assets": {
        "directory": "../app/.output/public",
        // A path with no file behind it (a deep link) gets `index.html` with a 200.
        "not_found_handling": "single-page-application",
        // Only these paths run the Worker; every other request is answered from the assets, unbilled. The
        // list form also turns off the `Sec-Fetch-Mode: navigate` heuristic, so `/api/...` reaches the
        // Worker even when typed into the address bar.
        "run_worker_first": ["/api/*"],
    },
    // Local only. The Worker builds the OAuth callback from `request.url`'s origin, and the app is opened on
    // `http://localhost:8787` — the OAuth App's registered callback is `http://localhost:8787/auth/callback`.
    // Under `bun run dev` the Worker listens on 8788 behind `nuxt dev`'s proxy, which rewrites `Host` to
    // 8788 and passes no `X-Forwarded-Host`; so `wrangler dev` presents every request as one to
    // `http://localhost:8787`, the app's origin, in `bun run dev` and `bun run preview` alike.
    "dev": {
        "host": "localhost:8787",
        "upstream_protocol": "http",
    },
    // Workers Logs and per-request CPU time in the dashboard.
    "observability": {
        "enabled": true,
    },
}
