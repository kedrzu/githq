        {
          "type": "frame",
          "id": "woSqk",
          "name": "Group header",
          "width": 1400,
          "layout": "vertical",
          "gap": 8,
          "padding": [
            40,
            0,
            0,
            0
          ],
          "children": [
            {
              "type": "text",
              "id": "a2dLX",
              "name": "Group title",
              "fill": "$fg",
              "content": "Find in the diff",
              "fontFamily": "$font",
              "fontSize": 22,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "e6Pau",
              "name": "Group note",
              "fill": "$fg-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "⌘F opens a find bar at the top right of the diff, floating over the code: the browser's own find can't see lines a virtual list doesn't draw. It searches every shown line of the diff — both sides, context included, not the hidden lines in gaps, not threads — and marks each match in the code in a translucent yellow that keeps the syntax colour readable; the current match is stronger and outlined. ↵ ⇧↵ in the field, ⌘G ⇧⌘G or F3 ⇧F3 anywhere walk the matches: the diff scrolls to each, the line cursor (D44) lands on its row, and the row's file becomes current. Match Case, Whole Word and Regex are toggles in the field, off by default. Esc in the field closes the bar and clears the marks; the cursor stays where the last match left it.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "j3lUuj",
          "name": "Row of screens",
          "gap": 80,
          "children": [
            {
              "type": "frame",
              "id": "X56AE",
              "name": "Slot · CR137 · Find: matches marked, one current",
              "width": 1440,
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "frame",
                  "id": "axFpZ",
                  "name": "Caption",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "text",
                      "id": "PezFe",
                      "name": "Caption title",
                      "fill": "$fg",
                      "content": "CR137 · Find: matches marked, one current",
                      "fontFamily": "$font",
                      "fontSize": 15,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "I9dQ4",
                      "name": "Caption note",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "⌘F opens the bar with the field focused (with the bar open, it selects the query; inside a comment box or the / filter, ⌘F stays the field's own). Typing searches as you type, over every shown line of the diff in its order — files as the file list orders them, rows top to bottom, in split the left half before the right; a context line drawn on both halves is one match, marked on both. Each match is marked; the count covers the whole pull request. The first match at or after the cursor becomes current: the diff scrolls it a third from the edge, the line cursor lands on its row (line 46, the newer half, so C comments there) and its file becomes current. The marks keep the syntax colour of what they cover — a comment, a string, a function's name, a property — on context, added and deleted lines alike; the current one is stronger and outlined. Lines hidden in gaps, collapsed files and files the / filter hides aren't searched.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
