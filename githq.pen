            },
            {
              "type": "text",
              "id": "XNt0x",
              "name": "Group note",
              "fill": "$fg-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The folder of a clone is added once, from the repository's Commits (the header's \"Add a local clone\") or the command menu, through the system's folder picker. githq reads the folder's origin and matches it to a tracked repository; adding a worktree's folder adds the clone it belongs to, with no question. Until then the header offers it; afterwards it shows the clone's folder.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
