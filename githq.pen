                    {
                      "type": "text",
                      "id": "FKkau",
                      "name": "Caption title",
                      "fill": "$fg",
                      "content": "W4a · A failed run, opened at the error",
                      "fontFamily": "$font",
                      "fontSize": 15,
                      "fontWeight": "500"
