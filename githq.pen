              "id": "xQ74v",
              "name": "Group note",
              "fill": "$fg-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Every commit row is two lines: the headline with its pull request and CI mark on the first, the refs, the author, the age and the short sha on the second, the sha left out of a list narrower than 640 px. CH64 and CH65 use commits with long names, several refs and a commit whose pull request and CI are not known yet; CH66 is CH54 at actual size on the taller row.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
