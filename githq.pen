                  "children": [
                    {
                      "type": "text",
                      "id": "O1Hx7S",
                      "name": "Caption title",
                      "fill": "$fg",
                      "content": "F12 · A resolved thread, folded and open",
                      "fontFamily": "$font",
                      "fontSize": 15,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "f3jyh",
                      "name": "Caption note",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A resolved code thread is folded by default, inside a review and on its own (a single line comment, posted without a review, sits on the rail like a comment: avatar in the gutter, “dkim commented on src/store/schema.ts”). Folded, it is one row: Resolved, a line of the first comment, who took part, how many comments, and Show; the whole row is the click target, Enter works on a focused one. Open, it reads like any other thread, with a Resolved head that folds it again (Hide), the reply field, and Unresolve next to who resolved it. Top: in sofiab's review. Bottom: on its own, as on F5.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
