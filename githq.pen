                    {
                      "type": "text",
                      "id": "iSmsD",
                      "name": "Caption note",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Privacy holds one switch: whether githq counts its use. It is on by default. The Worker counts successful sign-ins, token renewals, sign-outs and installer downloads, each as an event name and the client, web or desktop, and nothing about the user, their code or repositories. Turned off, it stops for the account, not just this device. The link opens the docs page that lists what is counted.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
