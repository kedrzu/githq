            {
              "type": "frame",
              "id": "wuC1d",
              "name": "Narrow cards",
              "layout": "vertical",
              "gap": 20,
              "children": [
                {
                  "type": "text",
                  "id": "Fj95O",
                  "name": "Note",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": 1400,
                  "content": "Narrow cards: the same card, chosen by the width of its container (a container query, not the window), below 480 px of thread width. The gutter avatar moves into the head (20 px) before the login, the verb drops and the age stays. When the head is still too tight, things give way in this order: the login truncates with an ellipsis; the description's Author chip drops before the login truncates. The ⋯ always stays at the end. What the wide review puts at the end of its head (\"2 threads · 1 resolved\", \"Show review\") moves to a line in the body right under the summary: the head stays the one 36 px band every card has, and the line sits where the reader decides to open the threads. In code review's sidebar the threads live in the diff, so that line is the jump: \"2 threads in files ↘\".",
                  "lineHeight": 1.45,
                  "fontFamily": "$font",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
