              "id": "OTrfX",
              "name": "Group note",
              "fill": "$fg-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "On Linux an update installs only when the user clicks Restart, and the system may ask for an administrator password at that moment. U1 stays as it is. When the install doesn't happen, the same segment says so and offers it again.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
