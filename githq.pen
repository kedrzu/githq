                    {
                      "type": "text",
                      "id": "qNqsx",
                      "name": "Caption note",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A full page at GitHub's address, with one document per job. It opens with the cursor on GitHub's error marker and the lines above it in view, because the cause is usually up there. Passed steps stay folded but are part of the document, so search covers them. The map on the right shows the whole log: red for errors, dividers for steps, the lighter band for what's in view. Keys run from small to big: J line, ⇧J step, ⌥J job. A warning is amber and says “Warning:” as an error says “Error:”. A line past the limit ends in a control, “… N more characters”: a click, or Enter on its line (the key shows there), opens the whole line.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
