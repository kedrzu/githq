            {
              "type": "text",
              "id": "nsjLS",
              "name": "Group note",
              "fill": "$fg-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Chosen: a status bar along the bottom of the window, one segment per surface (sidebar, list, item). It replaces the sidebar's sync line and is applied to every app screen in Direction D. The sheet lists every state; the four screens show the main ones on D1. K3 and K6 are drawn with the bar in States. Time on all screens: 14:14.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
