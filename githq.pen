            {
              "type": "text",
              "id": "lGNPz",
              "name": "Description",
              "fill": "$fg-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Every toast is one component in the bottom right corner, above the status bar. They stack in the order they came, the newest at the bottom, nearest the corner. Only the newest takes keys (its action keys and Esc) and shows them; the ones above keep their buttons for the mouse. Dismissing the newest hands the keys to the one before. A toast lasts one of three ways: brief (6 s) for news and outcomes, long (10 s) for Undo and failures the status bar keeps, pinned for what needs a decision. A timed toast drains an indigo ring around its ×; hovering or focusing it stops the clock.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
