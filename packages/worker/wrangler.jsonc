// The githq Worker — the whole app on one domain (D16). Cloudflare serves the SPA (the static build of
// `packages/app`) straight from its assets, without running any Worker code; the Worker runs only for `/`
// and `/_landing` (the landing page for a visitor without the signed-in cookie, the app for one with it —
// `src/home.ts`), for `/download/*` (a redirect to an installer of the latest release — `src/download.ts`), for `/docs/*`
// (the documentation site, `packages/docs`, built into the assets' `docs/` — `src/docs.ts`,
// `docs/decisions/docs-site-under-githq-dev-docs.md`) and for `/api/*`, where it serves GitHub's OAuth token endpoints: sign-in, refresh, revoke (D1, `src/githubOAuth.ts`) —
// GitHub's token endpoint answers no CORS and needs the client secret, so a browser cannot do it alone. The Worker is
// stateless: no storage, no task data. Deploy with `bun run deploy`
// from the repo root, which builds the SPA first.
//
// Secret: the OAuth App's `GITHUB_CLIENT_SECRET`. Production's is kept in the secret store and set with
// `bun --cwd packages/worker secrets:put:prod`. `wrangler dev` takes the development one from its environment
// (`scripts/withSecrets.sh`) or the repo root `.env`.
{
    "$schema": "./node_modules/wrangler/config-schema.json",
    // The Cloudflare account of kedrzu@gmail.com; deploys from CI (`.github/workflows/deploy.yml`) need it named.
    "account_id": "8626d3c4b429e16b14d1b4e1bb4df29f",
    "name": "githq",
    "main": "src/worker.ts",
    // Wrangler bundles `main` with esbuild; minified, the bundle is smaller and the Worker starts faster.
    "minify": true,
    "compatibility_date": "2026-10-15",
    // Names only. `wrangler dev` binds these from its environment and nothing else from it; `wrangler deploy` refuses
    // to go ahead if the Worker lacks one.
    "secrets": {
        "required": ["GITHUB_CLIENT_SECRET"],
    },
    // Which OAuth App this is (`packages/github/src/oauthClientIds.json`). `wrangler dev` lets its environment or an
    // `--env-file` replace it: the Worker's `dev` and `preview` run as `dev`, e2e as `e2e`.
    "vars": {
        "GITHQ_ENV": "prod",
    },
    "assets": {
        "directory": "../app/.output/public",
        // A path with no file behind it (a deep link) gets `index.html` with a 200.
        "not_found_handling": "single-page-application",
        // The Worker's way to the assets: `/` is answered from `index.html` (the app) or `_landing.html` (the
        // prerendered landing page), chosen by the cookie. Fetching through the binding does not run the Worker again.
        "binding": "ASSETS",
        // Only these paths run the Worker; every other request is answered from the assets, unbilled. `/` matches
        // the pathname alone, so `/?utm_source=x` too. `/_landing` is reserved for the Worker's own fetch of the
        // landing: from outside it answers the app, so the landing has no address of its own. The list form
        // also turns off the `Sec-Fetch-Mode: navigate` heuristic, so `/api/...` reaches the Worker even when
        // typed into the address bar. `/download/*` are the fixed links to the desktop installers (`src/download.ts`);
        // `/download` alone stays the app's page. `/docs/*` is the documentation site (`src/docs.ts`): an unknown
        // address there gets the docs' 404 page, not the app's shell; `/docs` alone is redirected to `/docs/` by the
        // assets first. `!/docs/assets/*` keeps the docs' hashed files, which always exist, off the Worker.
        "run_worker_first": ["/api/*", "/", "/_landing", "/download/*", "/docs/*", "!/docs/assets/*"],
    },
    // Production lives on githq.dev only. A Custom Domain: Cloudflare creates the DNS record and the certificate
    // on deploy, given the githq.dev zone is in this account. No `*.workers.dev` or preview URLs — the OAuth
    // callback is built from the request's origin, and the OAuth App knows only https://githq.dev/auth/callback.
    "routes": [{ "pattern": "githq.dev", "custom_domain": true }],
    "workers_dev": false,
    "preview_urls": false,
    // Local only. The Worker builds the OAuth callback from `request.url`'s origin, and the app is opened on
    // `http://localhost:8787` — the OAuth App's registered callback is `http://localhost:8787/auth/callback`.
    // Under `bun run dev` the Worker listens on 8788 behind `nuxt dev`'s proxy, which rewrites `Host` to
    // 8788 and passes no `X-Forwarded-Host`; so `wrangler dev` presents every request as one to
    // `http://localhost:8787`, the app's origin, in `bun run dev` and `bun run preview` alike.
    "dev": {
        "host": "localhost:8787",
        "upstream_protocol": "http",
    },
    // Opt-out usage statistics (`src/usage.ts`): anonymous counts of sign-ins, sign-outs and installer downloads,
    // written to Workers Analytics Engine. Write-only, so the Worker stays stateless; no identifier is written.
    "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "githq_usage" }],
    // Workers Logs and per-request CPU time in the dashboard.
    "observability": {
        "enabled": true,
    },
}
