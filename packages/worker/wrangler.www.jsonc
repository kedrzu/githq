// The `githq-www` Worker: www.githq.dev redirects to githq.dev (`src/wwwRedirect.ts`). No assets, no secrets.
// Deployed by `bun run deploy` together with the githq Worker (`wrangler.jsonc`).
{
    "$schema": "./node_modules/wrangler/config-schema.json",
    // The Cloudflare account of kedrzu@gmail.com; deploys from CI (`.github/workflows/deploy.yml`) need it named.
    "account_id": "8626d3c4b429e16b14d1b4e1bb4df29f",
    "name": "githq-www",
    "main": "src/wwwRedirect.ts",
    "minify": true,
    "compatibility_date": "2026-10-15",
    "routes": [{ "pattern": "www.githq.dev", "custom_domain": true }],
    "workers_dev": false,
    "preview_urls": false,
}
