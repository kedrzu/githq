{
    "name": "@githq/docs",
    "private": true,
    "description": "The githq documentation site (VitePress), served by the app's Worker under githq.dev/docs",
    "license": "AGPL-3.0-only",
    "type": "module",
    "scripts": {
        "dev": "vitepress dev --port 8789 --strictPort",
        "build": "vitepress build",
        "typecheck": "tsgo -p tsconfig.json"
    },
    "dependencies": {
        "@fontsource/geist": "5.3.0",
        "@fontsource/inter": "5.3.0",
        "@fontsource/jetbrains-mono": "5.3.0",
        "@githq/github": "workspace:*",
        "lucide-vue-next": "1.0.0",
        "vitepress": "1.6.4",
        "vue": "3.5.44"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "sass": "1.105.1"
    },
    "nx": {
        "targets": {
            "build": {
                "inputs": [
                    "production",
                    "^production",
                    "{workspaceRoot}/packages/app/styles/**/*.scss"
                ]
            }
        }
    }
}
