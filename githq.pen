                  "children": [
                    {
                      "type": "text",
                      "id": "Shs8m",
                      "name": "Caption title",
                      "fill": "$fg",
                      "content": "CH55 · One scroll: the facts, then the message",
                      "fontFamily": "$font",
                      "fontSize": 15,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "nBcAG",
                      "name": "Caption note",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The panel as it reads everywhere. No tabs and no second scroll area: the headline, the author line and one card of four groups (pull request with its title, checks, parents with their headlines, refs), then the message, all in one scroll. A red build names its failing check right in the Checks group, with the passed ones folded into one line; nothing hides behind a key, and each key sits on its group's head or row, so there is no footer of keys. The groups have their own heads and dividers, so the eye jumps to Checks or Parents instead of reading a column of labels. A long message only pushes the card up and away: the facts are read first, then the message.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
