{
    "name": "githq",
    "private": true,
    "license": "AGPL-3.0-only",
    "workspaces": [
        "packages/*",
        "nzyme/packages/*"
    ],
    "type": "module",
    "scripts": {
        "setup": "zsh setup.sh",
        "build": "tsgo --build",
        "typecheck": "bun run build && tsgo -p scripts && nx run-many -t typecheck --exclude='@nzyme/*'",
        "monorepo": "nzyme monorepo",
        "localise": "nzyme localise",
        "codegen": "nx run-many -t codegen,localise,monorepo",
        "prep": "nx run-many -t prep",
        "watch": "nx run-many -t watch,watch:localise,watch:monorepo,watch:tsc --parallel=100",
        "dev": "nx run-many -t dev,watch:localise --exclude='@nzyme/*' --parallel=100",
        "dev:desktop": "bun --cwd packages/desktop tauri dev",
        "preview": "bun run build && bun --cwd packages/app build && bun --cwd packages/worker preview --port 8787",
        "deploy": "bun run build && bun --cwd packages/app build && bun --cwd packages/worker deploy",
        "build:desktop": "bun run build && bun --cwd packages/desktop tauri build",
        "build:desktop:signed": "bun run build && GITHQ_ENV=prod bun nzyme secrets run -- bun --cwd packages/desktop tauri build --config '{\"bundle\":{\"createUpdaterArtifacts\":true}}'",
        "storybook": "bun --cwd packages/app storybook",
        "lighthouse": "bun --cwd packages/app lighthouse",
        "lint": "oxlint --type-aware --quiet --disable-nested-config --fix . && eslint --fix .",
        "lint:check": "oxlint --type-aware --quiet --disable-nested-config . && eslint .",
        "lint:warnings": "oxlint --type-aware --disable-nested-config .",
        "format": "oxfmt --disable-nested-config . > /dev/null && bun run format:md",
        "format:check": "oxfmt --check --disable-nested-config . && bun run format:md:check",
        "lint:nzyme": "bun run --cwd nzyme lint:check && bun run --cwd nzyme format:check",
        "tests": "TZ=UTC bun test --timeout 10000 --pass-with-no-tests --path-ignore-patterns='**/*.spec.ts' --path-ignore-patterns='**/dist/**' ./packages ./scripts",
        "test:stories": "nx run-many -t test:stories --exclude='@nzyme/*'",
        "e2e": "bun --cwd packages/e2e test",
        "clean": "del \"**/dist\" \"**/.output\" \"**/.nuxt\" \"**/.nx\" \"**/.nzyme\" \"**/*.tsbuildinfo\" \"**/storybook-static\" \"**/test-results\" \"**/playwright-report\" \"!**/node_modules/**\"",
        "clean:npm": "del \"**/node_modules\"",
        "reinstall": "bun run clean && bun run clean:npm && bun install",
        "index": "nzyme index",
        "format:md": "eslint --fix \"**/*.md\"",
        "format:md:check": "eslint \"**/*.md\""
    },
    "devDependencies": {
        "@nzyme/bitwarden": "workspace:*",
        "@nzyme/cli": "workspace:*",
        "@nzyme/cli-core": "workspace:*",
        "@nzyme/eslint": "workspace:*",
        "@nzyme/ioc": "workspace:*",
        "@nzyme/secrets": "workspace:*",
        "@nzyme/tsconfig": "workspace:*",
        "@types/bun": "1.4.4",
        "@types/node": "^26.6.6",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "del-cli": "8.0.1",
        "eslint": "10.14.0",
        "eslint-plugin-package-json": "1.14.0",
        "nx": "^24.0.5",
        "oxfmt": "0.77.0",
        "oxlint": "1.92.0",
        "oxlint-tsgolint": "7.0.2006"
    },
    "overrides": {
        "@types/bun": "1.4.4",
        "playwright": "1.64.0",
        "playwright-core": "1.64.0",
        "vue": "3.5.44",
        "vue-router": "5.4.0"
    },
    "packageManager": "bun@1.4.4",
    "nx": {
        "includedScripts": []
    },
    "nzyme": {
        "plugins": [
            "./scripts/secrets.ts"
        ]
    },
    "patchedDependencies": {
        "bun-types@1.4.4": "patches/bun-types@1.4.4.patch"
    }
}
