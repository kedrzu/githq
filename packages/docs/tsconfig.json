{
    // Written by hand, not generated by `bun run monorepo`: the package has no `tsconfig.esm.json`, so it builds
    // nothing for `tsgo --build` (VitePress builds the site) and stays out of the root references. This config only
    // type-checks the VitePress config and theme (`typecheck`) and gives type-aware lint the repo's module settings.
    "extends": "@nzyme/tsconfig/esm.json",
    "compilerOptions": {
        "noEmit": true,
        "composite": false,
        "incremental": false,
        // The theme runs in the browser.
        "lib": ["esnext", "dom", "dom.iterable"]
    },
    // `./**/*` would skip the dot-folder, so it is listed on its own. The config's helpers and their tests sit in `lib`:
    // `bun test` does not look inside dot-folders either.
    "include": [".vitepress/**/*.ts", "lib"],
    "exclude": [".vitepress/cache", "dist"]
}
