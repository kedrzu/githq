          "layout": "vertical",
          "gap": 12,
          "children": [
            {
              "type": "text",
              "id": "pDtto",
              "name": "Title",
              "fill": "$fg",
              "content": "OpenGraph images",
              "fontFamily": "Geist",
              "fontSize": 40,
              "fontWeight": "600",
              "letterSpacing": -1.2
            },
            {
              "type": "text",
              "id": "HCSxJ",
              "name": "Notes",
              "fill": "$fg-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "1200 × 630 (og:image, twitter:summary_large_image) and 1280 × 640 (GitHub repository social preview). Everything important sits inside the central safe area — X and Slack crop to ~1.91:1, iMessage and LinkedIn round the corners and can trim a few pixels off each edge. Headline stays ≥ 56 px so it reads in a 500 px wide feed card.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "normal"
            }
