            {
              "type": "text",
              "id": "yChuG",
              "name": "Group title",
              "fill": "$fg",
              "content": "4 · A commit's details",
              "fontFamily": "$font",
              "fontSize": 22,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "YfRPp",
              "name": "Group note",
              "fill": "$fg-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "↵ on a row, or a click, opens the commit's details. A commit is not an item: it has no state to edit and nothing to comment on, so it opens only in the panel, in the list's place, never as a modal or a page. J and K keep moving through the graph with the panel open, and the panel follows the selected row. P goes to the first parent, ⇧P to the second of a merge; ⇧↵ opens the commit's pull request as any item opens. Esc closes and the list comes back.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
