              "type": "text",
              "id": "ZfnBq",
              "name": "Description",
              "fill": "$fg-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The desktop app downloads updates in the background. When one is ready, githq says so quietly and waits: no modal, no countdown, never a forced restart. Restart applies it now; Later hides the notice until githq next starts, and an update that is still waiting installs whenever the user quits githq.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
