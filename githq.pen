          "name": "Status bar",
          "gap": 80,
          "children": [
            {
              "type": "frame",
              "id": "T2lUW",
              "name": "Status bar · spec",
              "width": 1440,
              "layout": "vertical",
              "gap": 40,
              "children": [
                {
                  "type": "frame",
