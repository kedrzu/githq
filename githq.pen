            {
              "type": "text",
              "id": "YdNfN",
              "name": "Group note",
              "fill": "$fg-2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Exactly one stop is focused at a time — a file's header, a diff row (in split, both halves of it), a thread or a gap — shared by the mouse and the keys: hovering a stop focuses it, ↓ ↑ move stop by stop, the screen keeps the cursor a third from its edges. The cursor's file is the current file (D44). The focused row shows a comment button between the number and the code, on both halves in split, each commenting on its half's line (an empty half on the row's line); C takes the newer line, or the older on a row with only an older line. The button's tooltip is the only place its key shows.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
