                      "fontSize": 15,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "JpbpK",
                      "name": "Caption note",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "One row pinned to the foot of the diff column, under the code: the count in bold, what it means, Discard review… and Submit review… (⇧S). It takes 44 px of height only while a review is pending, and with the conversation on it stays under the diff. Both buttons ask first: CR39 and CR75. #1202's row in the stack has an amber dot.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
