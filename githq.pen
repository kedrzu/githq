              "layout": "vertical",
              "gap": 14,
              "children": [
                {
                  "type": "frame",
                  "id": "Gj8Tj",
                  "name": "Caption",
                  "width": 1600,
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "text",
                      "id": "PMCVA",
                      "name": "Caption title",
                      "fill": "$fg",
                      "content": "CH59 · The pull request as a chip",
                      "fontFamily": "$font",
                      "fontSize": 16,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "D2HGg",
                      "name": "Caption note",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The pull request mark, its state icon and #number, sits in a chip: a 1 px $border outline, radius 4, 1 px of padding above and below and 5 px each side, the icon (12 px) and the number 3 px apart, 18 px tall, the number $fg-2 in mono 11.5. In a graph row it sits 4 px after the headline. The outline binds icon and number into one thing and sets the number apart from a branch name set in the same mono. The CI mark stays outside, 8 px after the chip. The chip is a link to the pull request: hovering it lifts the outline and the number to $fg. When the pull request is not known yet, the empty bar shows as before, with no chip around it. One component, Commit / PR chip, in the graph rows, the branch and tag list and the details' facts.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
