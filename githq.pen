                    },
                    {
                      "type": "text",
                      "id": "DlIWj",
                      "name": "Caption note",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Each line of a file not here yet is a quiet bar where its code will start, as long as a line of code might be: lengths around 26 characters, spread normally (σ 12, clamped 3–72), an indent that wanders between 0 and 4 levels, and a blank line now and then. The bars are drawn from the file's path, so a file always shows the same bars, in either layout, and nothing reshuffles on scroll. This is the look before a file's patch arrives, and for a file GitHub sends no patch for though it has lines: as many rows as its added and deleted lines, a guess, so no colour for added or deleted and no animation, only a shape. Once the patch is in, the bars take its hunk layout and tint (D45, CR111). Split follows the change: a modified file mirrors its context on both sides with runs that sit on one side only, an added file has bars on the right alone, a deleted one on the left alone.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
